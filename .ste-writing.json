{
  "meta": {
    "written_by": "ste-lint.py --init",
    "version": "v1.1.0",
    "note": [
      "This repository writes its own prose in STE. Delete this file to opt out.",
      "The words below are decisions, not words we could not be bothered to fix."
    ]
  },

  "settings": {
    "locale": "",
    "exclude": [
      "LICENSE",
      "**/data/**",
      "**/node_modules/**"
    ],
    "_note": [
      "No locale, so there is no spelling check. This repository writes American",
      "English, which is what ASD-STE100 rule 1.14 asks for."
    ]
  },

  "words": {
    "allow": [
      "agent", "API", "argument", "artifact", "ASD", "ASD-STE100",
      { "word": "branch", "pos": ["n", "v"] },
      { "word": "cache", "pos": ["n", "v"] },
      "checker", "CLI",
      { "word": "code", "pos": ["n", "v"] },
      { "word": "commit", "pos": ["n", "v"] },
      "config", "dependency", "dictionary", "directory", "documentation",
      "extractor", "file",
      { "word": "flag", "pos": ["n", "v"] },
      "glossary",
      { "word": "hook", "pos": ["n", "v"] },
      "identifier", "JSON", "linter", "locale",
      { "word": "log", "pos": ["n", "v"] },
      "markdown", "marker", "MCP",
      { "word": "merge", "pos": ["n", "v"] },
      "paragraph", "parser", "path", "pdftotext", "poppler", "prose", "Python",
      "README", "repository",
      { "word": "request", "pos": ["n", "v"] },
      "runbook", "schema", "script", "server", "session", "skill", "STE",
      "symlink", "syntax", "token", "workflow"
    ],

    "deny": {},

    "prefer": {},

    "_note": [
      "'request' is allowed for 'pull request', which is a technical noun in",
      "this field. The standard replaces the plain verb 'request' with TELL or",
      "WRITE.",
      "",
      "To see what this repository trips on: ste-lint.py --triage <paths>"
    ]
  }
}
